<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Koalakit.Auth.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>Koalakit</Authors>
    <Company>Koalakit</Company>
    <Description>Core authentication and authorization primitives for Koalakit applications including claims management, tokenization, and cryptographic signatures.</Description>
    <PackageTags>authentication;authorization;claims;tokenization;cryptography;jwt</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>

